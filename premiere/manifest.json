{
  "manifestVersion": 5,
  "id": "com.lihogloglo.autocut",
  "name": "Autocut",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "autocut",
      "label": {
        "default": "Autocut"
      },
      "minimumSize": {
        "width": 260,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 460
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
