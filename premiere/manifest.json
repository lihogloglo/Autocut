{
  "manifestVersion": 5,
  "id": "com.lihogloglo.fauxraccord",
  "name": "FauxRaccord",
  "version": "0.4.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "fauxraccord",
      "label": {
        "default": "FauxRaccord"
      },
      "minimumSize": {
        "width": 260,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 460
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["fauxraccord"],
      "extensions": []
    }
  }
}
