{
  "manifestVersion": 5,
  "id": "com.lihogloglo.fauxraccord",
  "name": "FauxRaccord",
  "version": "0.5.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "fauxraccord",
      "label": {
        "default": "FauxRaccord"
      },
      "minimumSize": {
        "width": 200,
        "height": 60
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 80
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 110
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "fauxraccord"
      ],
      "extensions": []
    }
  }
}
